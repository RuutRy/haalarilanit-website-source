{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true
  },
  "ignorePatterns": ["node_modules", "dist", "legacy-ref", "src/routeTree.gen.ts"],
  "plugins": ["react", "typescript", "import", "unicorn", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["src/components/text/Article.tsx"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["src/hooks/useIdleCallbackEffect.ts"],
      "rules": { "react-hooks/exhaustive-deps": "off" }
    }
  ]
}
